{
  "name": "nexora-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "Nexora gateway stub: checks sessions and settles them on the credits contract",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "session": "node --env-file-if-exists=.env src/cli.js session",
