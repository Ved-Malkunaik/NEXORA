{
  "name": "nexora-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "Nexora gateway: authenticates sessions, meters chat, verifies NEAR AI Cloud attestation, settles on the credits contract",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "session": "node --env-file-if-exists=.env src/cli.js session",
    "settle": "node --env-file-if-exists=.env src/cli.js settle",
    "start": "node --env-file-if-exists=.env src/server.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "near-api-js": "7.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
