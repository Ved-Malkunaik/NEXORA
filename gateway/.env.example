# Copy to gateway/.env (git-ignored). Never commit a real key.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
CONTRACT_ID=nexora-credits-<you>.testnet
GATEWAY_ACCOUNT_ID=nexora-gateway-<you>.testnet
# Prefer a function-call key limited to settle_session on CONTRACT_ID:
#   near account add-key nexora-gateway-<you>.testnet grant-function-call-access \
#     --allowance '1 NEAR' --contract-account-id nexora-credits-<you>.testnet \
#     --function-names 'settle_session' autogenerate-new-keypair print-to-terminal \
#     network-config testnet sign-with-keychain send
GATEWAY_PRIVATE_KEY=ed25519:...

# Model: free open models via OpenRouter (https://openrouter.ai/keys). NOT private inference: OpenRouter
# and the model's host can read prompts. Free tier: 20 requests/minute, 1000/day once the account has
# bought 10 credits (50/day before that). Without a key, replies are simulated and labelled.
OPENROUTER_API_KEY=
# Up to 3 models, tried in order (see https://openrouter.ai/models?q=free)
# OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
# Only use providers that say they do not store or train on prompts (may leave no free model available)
# OPENROUTER_DATA_COLLECTION=deny
# The gateway's own caps, a little under OpenRouter's
# OPENROUTER_RPM=18
# OPENROUTER_RPD=1000   (set 50 if the account has not bought 10 credits)

# Optional TEE mode instead: NEAR AI Cloud, with attestation checked before every prompt.
# MODEL_PROVIDER=nearai
NEARAI_API_KEY=
# A model NEAR hosts itself in a TEE (see https://cloud-api.near.ai/v1/models, owned_by "nearai")
# NEARAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Browser origins allowed to call the gateway (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173
# PORT=8787
