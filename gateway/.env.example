# Copy to gateway/.env (git-ignored). Never commit a real key.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
CONTRACT_ID=nexora-credits-<you>.testnet
GATEWAY_ACCOUNT_ID=nexora-gateway-<you>.testnet
# Prefer a function-call key limited to settle_session on CONTRACT_ID:
#   near account add-key nexora-gateway-<you>.testnet grant-function-call-access \
#     --allowance '1 NEAR' --contract-account-id nexora-credits-<you>.testnet \
#     --function-names 'settle_session' autogenerate-new-keypair print-to-terminal \
#     network-config testnet sign-with-keychain send
GATEWAY_PRIVATE_KEY=ed25519:...
