{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix gateway --omit=dev",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?__path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/v1/sweep", "schedule": "0 3 * * *" }]
}
