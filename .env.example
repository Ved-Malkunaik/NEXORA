# Copy to .env.local and adjust. All values are public (they ship to the browser).

# Network the app opens on: testnet | mainnet
VITE_DEFAULT_NETWORK=testnet

# Credits-ledger contract the session key is scoped to (deployed in Level 1)
VITE_TESTNET_CONTRACT_ID=nexora-credits.testnet
VITE_MAINNET_CONTRACT_ID=nexora-credits.near

# Optional RPC overrides
# VITE_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com
# VITE_MAINNET_RPC_URL=https://rpc.mainnet.fastnear.com
